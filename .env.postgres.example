# Copiar a .env.postgres (no commitear). Usado por docker-compose.postgres.yml
#
# En el mismo servidor que mcflow-postgres (puerto 5433), Mi Cole usa 5434 por defecto.

DATABASE_USER=micole
DATABASE_PASSWORD=change-me-strong-password
DATABASE_NAME=mi_cole_db

# Puerto en el host (solo localhost). La app en Docker usa host.docker.internal + este puerto.
POSTGRES_PORT=5434
