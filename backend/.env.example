# Copiar a backend/.env y ajustar (no commitear secretos).
#
# Desarrollo local (uvicorn en el host): DATABASE_HOST=localhost, PORT=5432
# App en Docker + Postgres en docker-compose.postgres.yml (prod/dev):
#   DATABASE_HOST=host.docker.internal
#   DATABASE_PORT=5434   (ver POSTGRES_PORT en .env.postgres)
# App en Docker + perfil local-db: DATABASE_HOST=db, PORT=5432, user/pass micole

# ─── Base de datos ───────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=micole
DATABASE_PASSWORD=tu_password
DATABASE_NAME=mi_cole_db

# Alternativa: URL completa (si la defines, ignora las variables de arriba)
# DATABASE_URL=postgresql+psycopg://postgres:tu_password@localhost:5432/mi_cole_db

# ─── Auth / API ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ─── SPA (Docker setea STATIC_ROOT; vacío en dev solo-API) ───────────────────
# STATIC_ROOT=

# Comprobantes de pago (dev: backend/storage/uploads)
# STORAGE_ROOT=

# Branding login por sede (fallback si no hay logo en colegio/sede)
# PLATFORM_LOGIN_LOGO_URL=
# PLATFORM_LOGIN_SUBTITLE=Mi Cole — Plataforma educativa
# PLATFORM_LOGIN_PRIMARY_COLOR=#2563eb

# ─── Seed superadmin (CLI seed-superadmin) ───────────────────────────────────
SUPERADMIN_EMAIL=superadmin@micole.dev
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_NAME=Super Admin
